# Virtual environment — never copy into image
.venv/

# Compiled Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Local secrets — set as Render environment variables instead
.env
.env.local
.env.*.local

# Legacy SQLite fallback data — never copy into the PostgreSQL deployment
storage/
*.db

# Development / editor noise
.git/
.gitignore
*.md
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
