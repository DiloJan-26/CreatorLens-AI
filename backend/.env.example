# Required local connections/trusted identity. No authentication enable switch.
# For cloud set ENVIRONMENT=production; use verified TLS PostgreSQL/Redis.
ENVIRONMENT=local
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
QDRANT_URL=
QDRANT_API_KEY=
CORS_ORIGINS=http://localhost:3000

# Engaged for initial release. Releasing this alone never authorizes a provider.
PROVIDER_EMERGENCY_STOP=true

# Azure worker only: SERVICE_ROLE=worker. API defaults to web.
# Optional reviewed model override; intended default is gemini-3.5-flash-lite.
# LLM_MODEL=gemini-3.5-flash-lite
# No fallback model, auth-mode, demo-mode or subscription variables exist.

# Provider credentials for live operation. API and worker must match.
# GEMINI_API_KEY=
# SUPADATA_API_KEY=
# Set PROVIDER_EMERGENCY_STOP=false deliberately when ready for live requests.
# Supadata plan, prepaid attestations and a manually entered credit pool are NOT required.
# Optional cost-reporting overrides; not required for Supadata extraction:
# LLM_ACTIVE_PRICING_JSON=<reviewed complete operator-approved JSON envelope>
# EXTRACTION_ACTIVE_PRICING_JSON=<reviewed complete operator-approved JSON envelope>

# Quotas, rates, budgets and transport caps already have approved defaults.
# See Deployment-Environment-Matrix.md before overriding a specific policy.

# Optional official YouTube enrichment; uses existing YOUTUBE_API_KEY and shared Redis.
# Enabled by default when the existing API key and execution prerequisites are configured. API and worker must match. Units are attempted list requests/day.
YOUTUBE_METADATA_ENRICHMENT_ENABLED=true
YOUTUBE_ENRICHMENT_DAILY_UNITS=100

# Render API only: private random URL-safe key (32-256 characters).
# Missing key leaves Engineering locked; never use NEXT_PUBLIC_ for this secret.
ENGINEERING_ACCESS_KEY=
# Optional: fixed unlock duration in seconds (default 1800; allowed 60-3600).
# ENGINEERING_UNLOCK_SECONDS=1800
