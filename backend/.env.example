# local: ENVIRONMENT=local
# production (Render): ENVIRONMENT=production
ENVIRONMENT=local
SERVICE_ROLE=web

# Comma-separated list of allowed frontend origins.
# local:      CORS_ORIGINS=http://localhost:3000
# production: CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection strings. Use separate cloud databases/branches so tests
# cannot modify development or staging data. Never commit real values.
DATABASE_URL=
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# Redis/Celery configuration. For the normal cloud workflow, REDIS_URL can be
# the same TLS-enabled Upstash connection URL for both the broker and result
# backend. The two CELERY_* values are optional overrides.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_RESULT_EXPIRES_SECONDS=3600
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_MAX_RETRIES=2
CELERY_RETRY_BACKOFF_SECONDS=15
CELERY_BROKER_CONNECTION_TIMEOUT_SECONDS=5
CELERY_WORKER_CONCURRENCY=1
CELERY_LOG_LEVEL=INFO

GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.35
LLM_MAX_OUTPUT_TOKENS=2200
DEBUG_RAG_PROMPT=false

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=creatorlens_chunks
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

YOUTUBE_API_KEY=
APIFY_API_TOKEN=
APIFY_YOUTUBE_TRANSCRIPT_ACTOR=abotapi/youtube-transcript-scraper
APIFY_YOUTUBE_TRANSCRIPT_INPUT_STYLE=videoUrls
APIFY_YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=120
DEEPGRAM_API_KEY=
TRANSCRIPT_LANGUAGE=multi
TRANSCRIPT_FALLBACK_LANGUAGES=en,hi,ta
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DETECT_LANGUAGE=true
ASSEMBLYAI_API_KEY=
